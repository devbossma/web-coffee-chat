<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Coffee Shop</display-name>

    <listener>
        <listener-class>listener.AppInitListener</listener-class>
    </listener>

    <!-- Customer-facing -->

    <servlet>
        <servlet-name>CoffeeShopController</servlet-name>
        <servlet-class>controller.CoffeeShopController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CoffeeShopController</servlet-name>
        <url-pattern>/coffeeshop</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OrderController</servlet-name>
        <servlet-class>controller.OrderController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrderController</servlet-name>
        <url-pattern>/coffeeshop/orders</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ChatController</servlet-name>
        <servlet-class>controller.ChatController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ChatController</servlet-name>
        <url-pattern>/chat</url-pattern>
    </servlet-mapping>

    <!-- Barista-facing -->

    <servlet>
        <servlet-name>BaristaLoginController</servlet-name>
        <servlet-class>controller.BaristaLoginController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BaristaLoginController</servlet-name>
        <url-pattern>/barista/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BaristaConsoleController</servlet-name>
        <servlet-class>controller.BaristaConsoleController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BaristaConsoleController</servlet-name>
        <url-pattern>/barista/console</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BaristaOrderController</servlet-name>
        <servlet-class>controller.BaristaOrderController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BaristaOrderController</servlet-name>
        <url-pattern>/barista/orders</url-pattern>
    </servlet-mapping>

    <!-- Everything under /barista except /barista/login itself requires a logged-in barista. -->
    <filter>
        <filter-name>BaristaAuthFilter</filter-name>
        <filter-class>filter.BaristaAuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>BaristaAuthFilter</filter-name>
        <url-pattern>/barista/console</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>BaristaAuthFilter</filter-name>
        <url-pattern>/barista/orders</url-pattern>
    </filter-mapping>

</web-app>
